def get_importance_history(boruta_obj):
    for attr in ['importance_history_', '_importance_history', 'history_']:
        if hasattr(boruta_obj, attr):
            return getattr(boruta_obj, attr)
    raise AttributeError("importance_history attribute not found")

def plot_boruta_custom(ax, boruta_obj, feature_names, title=''):
    imp_hist = get_importance_history(boruta_obj)
    n_real = len(feature_names)
    n_rows, n_cols = imp_hist.shape

    if n_cols == n_real:
        real_imp = imp_hist.T.copy()
    elif n_rows == n_real:
        real_imp = imp_hist.copy()
    elif n_cols > n_real:
        real_imp = imp_hist[:, :n_real].T.copy()
    elif n_rows > n_real:
        real_imp = imp_hist[:n_real, :].copy()
    else:
        raise ValueError(f"Cannot parse: {imp_hist.shape} vs {n_real}")

    if real_imp.shape[1] > 1:
        zero_cols = (real_imp == 0).all(axis=0)
        if zero_cols.sum() > 0:
            real_imp = real_imp[:, ~zero_cols]

    n_nan = int(np.isnan(real_imp).sum())
    if n_nan > 0:
        row_med = np.nanmedian(real_imp, axis=1, keepdims=True)
        nan_mask = np.isnan(real_imp)
        real_imp = np.where(nan_mask, row_med, real_imp)

    medians = np.median(real_imp, axis=1)
    order = np.argsort(-medians)
    ordered_names = [feature_names[i] for i in order]
    ordered_imp = real_imp[order, :]

    colors = []
    for i in order:
        if boruta_obj.support_[i]:
            colors.append('#2ca02c')
        elif boruta_obj.support_weak_[i]:
            colors.append('#f4d03f')
        else:
            colors.append('#e53935')

    n_feats = len(ordered_names)
    box_data = []
    valid_positions = []
    for i in range(n_feats):
        vals = ordered_imp[i, :]
        vals = vals[~np.isnan(vals)]
        if len(vals) == 0:
            continue
        box_data.append(vals)
        valid_positions.append(i)

    if len(box_data) == 0:
        return

    bp = ax.boxplot(
        box_data, positions=valid_positions, widths=0.65, patch_artist=True, showfliers=False,
        medianprops=dict(color='black', linewidth=1.5),
        whiskerprops=dict(color='gray', linewidth=0.8),
        capprops=dict(color='gray', linewidth=0.8),
        boxprops=dict(linewidth=1.0),
    )
    for patch, pos in zip(bp['boxes'], valid_positions):
        patch.set_facecolor(colors[pos])
        patch.set_alpha(0.75)

    shadow_max = None
    if n_rows < n_real or n_cols > n_real:
        try:
            if n_cols > n_real:
                shadow_imp = imp_hist[:, n_real:].T
            elif n_rows > n_real:
                shadow_imp = imp_hist[n_real:, :]
            else:
                shadow_imp = None
            if shadow_imp is not None and shadow_imp.size > 0:
                shadow_max = shadow_imp.max(axis=0)
        except Exception:
            shadow_max = None

    if shadow_max is not None and len(shadow_max) > 0:
        ax.axhline(np.median(shadow_max), color='navy', ls='--', lw=1.8, label=f'Shadow median = {np.median(shadow_max):.3f}')
        ax.axhline(np.percentile(shadow_max, 25), color='navy', ls=':', lw=1.2, alpha=0.6, label='Shadow 25th percentile')
        ax.axhline(np.max(shadow_max), color='navy', ls='-.', lw=1.2, alpha=0.6, label='Shadow max')

    ax.set_xticks(np.arange(n_feats))
    ax.set_xticklabels(ordered_names, rotation=45, ha='right', fontsize=7)
    ax.set_ylabel('Importance (Z-score)', fontsize=12)
    ax.grid(axis='y', alpha=0.2)

    n_rej = int((~boruta_obj.support_ & ~boruta_obj.support_weak_).sum())
    legend_elements = [
        Patch(facecolor='#2ca02c', alpha=0.75, edgecolor='black', label=f'Confirmed ({int(boruta_obj.support_.sum())})'),
        Patch(facecolor='#f4d03f', alpha=0.75, edgecolor='black', label=f'Tentative ({int(boruta_obj.support_weak_.sum())})'),
        Patch(facecolor='#e53935', alpha=0.75, edgecolor='black', label=f'Rejected ({n_rej})'),
    ]
    if shadow_max is not None:
        legend_elements.append(mpatches.Patch(facecolor='none', edgecolor='navy', linestyle='--', label='Shadow threshold'))
    
    ax.legend(handles=legend_elements, loc='upper right', frameon=False, fontsize=9)
    
    if title:
        ax.set_title(title, fontsize=16)
    sns.despine(ax=ax)

