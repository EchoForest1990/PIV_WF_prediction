def tune_catboost_native(X_tr, y_tr, scale_pos_weight,
                          n_iter=30, cv_folds=5, random_state=42):
    np.random.seed(random_state)

    X_tr_np = X_tr.astype(float).values if hasattr(X_tr, 'values') \
              else np.asarray(X_tr, dtype=float)
    y_tr_np = np.asarray(y_tr, dtype=float)

    if np.isnan(X_tr_np).any() or np.isnan(y_tr_np).any():
        col_median = np.nanmedian(X_tr_np, axis=0)
        inds = np.where(np.isnan(X_tr_np))
        X_tr_np[inds] = np.take(col_median, inds[1])

    skf_inner = StratifiedKFold(n_splits=cv_folds, shuffle=True,
                                  random_state=random_state)

    best_auc = 0.0
    best_params = None
    history = []
    fail_count = 0

    for i in range(n_iter):
        params = {
            'iterations': int(np.random.randint(100, 600)),
            'depth': int(np.random.randint(3, 10)),
            'learning_rate': float(np.exp(np.random.uniform(
                np.log(1e-3), np.log(0.3)))),
            'l2_leaf_reg': float(np.exp(np.random.uniform(
                np.log(1e-3), np.log(10)))),
            'scale_pos_weight': float(scale_pos_weight),
            'loss_function': 'Logloss',
            'eval_metric': 'AUC',
            'random_seed': random_state,
            'silent': True,
            'allow_writing_files': False,
        }

        fold_auc = []
        for tr_idx, val_idx in skf_inner.split(X_tr_np, y_tr_np):
            try:
                model = CatBoostClassifier(**params)
                model.fit(X_tr_np[tr_idx], y_tr_np[tr_idx])
                prob = model.predict_proba(X_tr_np[val_idx])[:, 1]
                fold_auc.append(roc_auc_score(y_tr_np[val_idx], prob))
            except Exception as e:
                if fail_count < 3:
                    print(f"  [CatBoost err {fail_count+1}] "
                          f"{type(e).__name__}: {e}")
                    fail_count += 1
                fold_auc.append(np.nan)

        if len(fold_auc) == 0 or np.all(np.isnan(fold_auc)):
            continue

        mean_auc = np.nanmean(fold_auc)
        history.append(mean_auc)

        if mean_auc > best_auc:
            best_auc = mean_auc
            best_params = params.copy()

    print(f"  [Debug] {len(history)} valid iterations, "
          f"best CV AUC = {best_auc:.4f}")

    return best_params, best_auc, history

